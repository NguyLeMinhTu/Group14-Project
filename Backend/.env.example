# Backend Environment Variables (Template)
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# MongoDB connection
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=dbname

# JWT secrets (use strong random values in production)
JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here
REFRESH_EXPIRES_DAYS=7

# Server
PORT=3000
NODE_ENV=development

# Frontend origin (for CORS and reset password links)
FRONTEND_ORIGIN=http://localhost:5173

# Email (Gmail SMTP for nodemailer)
EMAIL_SERVICE=gmail
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# Cloudinary (for avatar uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
